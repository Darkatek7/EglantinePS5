Subject: [PATCH 04/22] 0031-macro-state-writes

(cherry picked from commit 9464603c08cace161837030eae6be6ffdb7ed1e3)
---
 src/video_core/engines/maxwell_3d.cpp | 16 ++++++++++++++++
 src/video_core/engines/maxwell_3d.h   |  8 ++++++++
 src/video_core/macro.cpp              |  2 +-
 3 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/src/video_core/engines/maxwell_3d.cpp b/src/video_core/engines/maxwell_3d.cpp
index 48f4af69e3..6057abc8cd 100644
--- a/src/video_core/engines/maxwell_3d.cpp
+++ b/src/video_core/engines/maxwell_3d.cpp
@@ -510,6 +510,22 @@ void Maxwell3D::TraceFirstMethodWrite(u32 method, u32 argument) {
     }
 }
 
+void Maxwell3D::MacroWrite(Core::System& system, u32 method, u32 argument) {
+    bool bookkeeping = g_trace_first_method_writes || VideoCommon::Nx2Profile::Enabled();
+#ifdef ARCHITECTURE_x86_64
+    bookkeeping = bookkeeping || TuringMacroJit::RtDump::RecordingConfigured();
+#endif
+    if (method < MacroRegistersStart && !execution_mask[method] && !front_macros && !bookkeeping)
+        [[likely]] {
+        const u32 value = ProcessShadowRam(method, argument);
+        if (!SkipSameValueWrites() || regs.reg_array[method] != value) {
+            ProcessDirtyRegisters(method, value);
+        }
+        return;
+    }
+    CallMethod(system, method, argument, true);
+}
+
 void Maxwell3D::CallMethod(Core::System& system, u32 method, u32 method_argument, bool is_last_call) {
     if (front_macros && !VideoCommon::GpuSplit::OnBackThread()) {
         ReleaseFront();
diff --git a/src/video_core/engines/maxwell_3d.h b/src/video_core/engines/maxwell_3d.h
index 1b491d5344..0e1098b071 100644
--- a/src/video_core/engines/maxwell_3d.h
+++ b/src/video_core/engines/maxwell_3d.h
@@ -3336,6 +3336,14 @@ private:
         }
     }
 
+public:
+    /// A register write a macro makes (MacroEngine::Execute): a state register (not in
+    /// execution_mask) takes a short path with CallMethod's effect (shadow RAM, the same-value
+    /// skip, dirty flags); anything else, and every write while profiling or tracing, takes
+    /// CallMethod itself.
+    void MacroWrite(Core::System& system, u32 method, u32 argument);
+
+private:
     void ConsumeSinkImpl(Core::System& system) override;
 
     void ProcessMethodCall(u32 method, u32 argument, u32 nonshadow_argument, bool is_last_call);
diff --git a/src/video_core/macro.cpp b/src/video_core/macro.cpp
index 2313727679..4106ad1c4f 100644
--- a/src/video_core/macro.cpp
+++ b/src/video_core/macro.cpp
@@ -1417,7 +1417,7 @@ void MacroEngine::Execute(Core::System& system, Engines::Maxwell3D& maxwell3d, u
                 }
                 {
                     VideoCommon::Nx2Profile::Scope method_scope{VideoCommon::Nx2Profile::Zone::Method};
-                    maxwell3d.CallMethod(system, address, value, true);
+                    maxwell3d.MacroWrite(system, address, value);
                 }
                 // Turing MME memory reads (methods 0x550 SET_MME_MEM_ADDRESS_A/B, 0x558 data RAM
                 // address, 0x55c MME_DMA_READ into data RAM, 0x560 MME_DMA_READ_FIFOED into
