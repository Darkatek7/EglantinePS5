---
 src/core/hle/service/nvdrv/devices/nx2_stub_device.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/core/hle/service/nvdrv/devices/nx2_stub_device.h b/src/core/hle/service/nvdrv/devices/nx2_stub_device.h
index 23b7bedf93..e5c603c8b0 100644
